# NeverMind — environment variable template
# Copy to `.env` (git-ignored) and fill in. The app itself does NOT parse
# `.env` — Docker Compose reads it for substitution automatically; for bare
# metal, `export $(grep -v '^#' .env | xargs)` or use your host's secret store.

# ── Server ──────────────────────────────────────────────────────────────
# Bind address (default 0.0.0.0) and explicit port. If unset, PaaS-injected
# $PORT is honoured (Render/Fly style), else 8317.
NEVERMIND_HOST=0.0.0.0
NEVERMIND_PORT=8317
#PORT=10000

# ── GitHub OAuth login (optional — guest mode works without it) ─────────
# Create at: GitHub → Settings → Developer settings → OAuth Apps
# Callback URL:  https://<your-domain>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Session signing secret (required once GitHub login is enabled) ──────
# Generate:  openssl rand -hex 32
# Rotating it invalidates existing sign-ins (7-day HMAC cookies).
NEVERMIND_SESSION_SECRET=
